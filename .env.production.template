# Production Environment Configuration Template
# Copy this file and fill in the values with your actual production credentials

# Application Environment
APP_ENV=prod
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://your-frontend-url.com
BACKEND_URL=https://your-backend-url.onrender.com

# Admin User
ADMIN_NAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# Instructor User
INSTRUCTOR_NAME=instructor
INSTRUCTOR_EMAIL=instructor@yourdomain.com
INSTRUCTOR_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# Learner User
LEARNER_NAME=learner
LEARNER_EMAIL=learner@yourdomain.com
LEARNER_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# JWT Configuration (Generate strong random secrets)
JWT_ACCESS_SECRET=GENERATE_STRONG_RANDOM_SECRET_HERE
JWT_ACCESS_EXPIRATION=365d
JWT_ACCESS_EXPIRATION_COOKIE=3000000000

JWT_REFRESH_SECRET=GENERATE_DIFFERENT_STRONG_RANDOM_SECRET_HERE
JWT_REFRESH_EXPIRATION=7d
JWT_REFRESH_EXPIRATION_COOKIE=604800000

# PostgreSQL Database Configuration (from Neon.tech or Supabase)
DB_HOST=your-postgres-host.neon.tech
DB_PORT=5432
DB_NAME=edu
DB_USER=your-postgres-username
DB_PASSWORD=your-postgres-password

# MongoDB Configuration (from MongoDB Atlas)
MONGO_USERNAME=your-mongo-username
MONGO_PASSWORD=your-mongo-password
MONGO_HOST=cluster0.xxxxx.mongodb.net
MONGO_PORT=27017
MONGO_DB=edu
MONGO_AUTH_DB=admin

# Mail Configuration (Gmail App Password recommended)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=your-email@gmail.com

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
CALLBACKURL=https://your-backend-url.onrender.com/auth/google/callback

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# VNPay Configuration (Production)
VNPAY_TMN_CODE=your-vnpay-terminal-code
VNPAY_HASH_SECRET=your-vnpay-hash-secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://your-backend-url.onrender.com/payments/vnpay-return

# Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key
